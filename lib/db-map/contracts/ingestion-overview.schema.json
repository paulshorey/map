{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:poi-map:ingestion-overview:1",
  "type": "object",
  "required": [
    "schema_version",
    "observed_at",
    "components",
    "summary",
    "decision",
    "interventions",
    "improvements",
    "files",
    "worker_liveness",
    "import_queue",
    "recent_executions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "object",
      "required": ["database", "local"],
      "properties": {
        "database": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "enum": ["available", "unknown"]
            }
          }
        },
        "local": {
          "type": "object",
          "required": ["observed_at", "jobs", "claims", "errors"],
          "properties": {
            "observed_at": {
              "type": "string"
            },
            "jobs": {
              "type": "array"
            },
            "claims": {
              "type": "array"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": ["object", "null"],
      "required": ["ready_to_verify", "coverage_counts"],
      "properties": {
        "ready_to_verify": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string"
        }
      }
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "scope", "severity"]
      }
    },
    "improvements": {
      "type": "array"
    },
    "files": {
      "type": "array"
    },
    "worker_liveness": {
      "type": ["object", "null"],
      "required": ["confirmed", "unconfirmed", "workers"],
      "properties": {
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "unconfirmed": {
          "type": "integer",
          "minimum": 0
        },
        "workers": {
          "type": "array"
        }
      }
    },
    "import_queue": {
      "type": ["object", "null"],
      "required": [
        "active",
        "evidence",
        "id",
        "journal_available",
        "current",
        "recent_finished"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "evidence": {
          "enum": ["lock", "starting", "journal_only", "none"]
        },
        "id": {
          "type": ["string", "null"]
        },
        "journal_available": {
          "type": "boolean"
        },
        "current": {
          "type": ["object", "null"]
        },
        "recent_finished": {
          "type": "array"
        }
      }
    },
    "recent_executions": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "components": {
            "properties": {
              "database": {
                "properties": {
                  "status": {
                    "const": "unknown"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "summary": {
            "type": "null"
          },
          "decision": {
            "properties": {
              "action": {
                "const": "inspect"
              }
            }
          },
          "worker_liveness": {
            "type": "null"
          },
          "import_queue": {
            "type": "null"
          }
        }
      }
    }
  ]
}
