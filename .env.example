# This file is only documentation. Below environment variables
# must be injected by the shell or cloud-agent host. Do not commit values.
# Cloud agent VMs should run: bash scripts/agent-env.sh setup

# Required for everything, must be defined in shell environment
# PostgreSQL connection (back-end only)
DB_MAP_URL= 


# ── POI ingestion pipeline ───────────────────────────────────

# Geocoding (forward geocode for records missing coordinates)
GEOCODER_PROVIDER=locationiq
LOCATIONIQ_API_KEY=

# Embeddings (dimension MUST match research_pois.content_embedding real[] length)
EMBEDDINGS_PROVIDER=jina
EMBEDDINGS_MODEL=jina-embeddings-v3
EMBEDDINGS_DIM=384

# LLM for normalization, gray-zone match adjudication, and description fusion
# Create a key at https://fireworks.ai/account/api-keys
LLM_PROVIDER=fireworks
LLM_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
FIREWORKS_API_KEY=

# Jina embeddings (also used when EMBEDDINGS_PROVIDER=jina)
JINA_API_KEY=

# Optional matcher tuning overrides (defaults live in ingest/config.ts)
INGEST_MATCH_T_HIGH=0.85
INGEST_MATCH_T_LOW=0.55


# ── Optional extra features ───────────────────────────────────


# Thunderforest premium tiles (optional)
THUNDERFOREST_API_KEY=

# Required for Capacitor mobile builds — URL of the deployed Next.js server
# that hosts /api/* routes (e.g. https://poi-map.example.com)
NEXT_PUBLIC_API_URL=